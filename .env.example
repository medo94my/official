# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Docker Compose (see docker-compose.yml):
DATABASE_URL="postgresql://portfolio:CHANGE_ME@localhost:5432/portfolio?schema=public"
# Local SQLite alternative (requires provider = "sqlite" in prisma/schema.prisma):
# DATABASE_URL="file:./dev.db"

POSTGRES_USER="portfolio"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="portfolio"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Seed (lib/migrate-old-data.ts) ---
# The seed refuses to run if ADMIN_PASSWORD is unset.
ADMIN_EMAIL="medoroyalrma@gmail.com"
ADMIN_PASSWORD=""

# --- Optional: AI voice input on the admin forms ---
OPENAI_API_KEY=""

# --- Public site config (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Digits only, no '+' or spaces, e.g. 601111884535
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Contact / idea forms (EmailJS) ---
# The forms are hidden when these are unset.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_IDEA_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
