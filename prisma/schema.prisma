// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // The Docker image is Alpine (musl + OpenSSL 3). Without this the engine
  // built on the host will not load inside the container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String  @id @default(cuid())
  // Unique so the seed can upsert on it and stay idempotent.
  title       String  @unique
  /// URL segment for /projects/[slug]. Derived from the title by the seed and
  /// by the admin form, editable afterwards. Unique because it is a route.
  slug        String  @unique
  description String
  type        String // "Solo" or "Team"
  image       String?
  githubUrl   String?
  liveUrl     String?
  tags        String  @default("") // Comma-separated technologies
  /// Engineering properties shown as a spec grid, one per line as
  /// "LABEL: value" — e.g. "RETRY: exponential + jitter, 3 attempts".
  /// Plain text rather than JSON so it stays editable in a textarea.
  specs       String?
  featured    Boolean @default(false)
  order       Int     @default(0)

  // ── Case study ───────────────────────────────────────────────────────
  // Every field is optional and every one starts empty. The detail page
  // renders only the blocks that have content, and `hasCaseStudy()` in
  // lib/content.ts decides whether to link to it at all — so a project with
  // none of this set behaves exactly as it did before the columns existed.
  //
  // Free text, never Json: the admin is hand-rolled textareas, and a Json
  // column becomes a syntax-error trap for the one person who edits it.
  // Multi-item fields are one item per line (parseLines); label/value fields
  // reuse the existing "LABEL: value" format (parseSpecs).
  /// Prose. What was actually wrong before this existed.
  problem          String?
  /// Prose, short. Who it is for.
  audience         String?
  /// Prose. Where it sits, what it replaced.
  context          String?
  /// One per line.
  constraints      String?
  /// Prose, short.
  myRole           String?
  /// One per line.
  responsibilities String?
  /// Prose. How it was approached.
  approach         String?
  /// "Decision: rationale", one per line.
  keyDecisions     String?
  /// One per line.
  challenges       String?
  /// "Gained: …" / "Gave up: …", one per line.
  tradeoffs        String?
  /// Prose. What actually happened. Left empty unless it is verifiable.
  outcome          String?
  /// One per line.
  lessons          String?
  /// Free text, owner-set. Nullable on purpose — an unverified "Shipped"
  /// badge is a claim, and claims are the owner's to make (same rule as Stat).
  status           String?
  /// A longer write-up hosted elsewhere, if one exists.
  caseStudyUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media ProjectMedia[]

  @@index([featured, order])
}

/// A blog post.
///
/// Deliberately close in shape to Project: unique title, unique slug, a
/// comma-separated tag column, plain-text body. Everything an editor touches is
/// a textarea, so there is no JSON column waiting to become a syntax-error trap
/// for the one person who edits it.
model Post {
  id      String @id @default(cuid())
  title   String @unique
  slug    String @unique
  /// One or two sentences. Required rather than optional: it is the index
  /// entry, the meta description and the RSS body, and a post without one is a
  /// bad search result three times over.
  summary String
  /// Markdown. Rendered server-side with raw HTML disabled — see
  /// components/PostBody.tsx, where that is the security boundary.
  body    String
  tags    String @default("")

  /// Site-relative, from the media upload. Never a remote URL.
  coverImage String?
  coverAlt   String  @default("")

  /// "draft" | "published". Free text, matching `Project.type` and
  /// `Project.status`, rather than introducing this schema's first enum.
  status      String    @default("draft")
  /// Set once, on first publish. Editing a post later must not reorder the
  /// index or tell every feed reader it is new again.
  publishedAt DateTime?

  /// True while the body is still exactly as a model wrote it, cleared on any
  /// manual edit. Drives the admin notice, so an unreviewed draft is visibly
  /// unreviewed rather than looking like something the owner wrote.
  aiDrafted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every public read is "published, newest first".
  @@index([status, publishedAt])
}

/// Screenshots and short silent clips for a project.
///
/// Separate from `Project.image`, which stays the single cover used by the list
/// entry and the case-study header. This is the gallery: additional stills and
/// the screen recordings that are the only honest way to show a CLI or an API
/// actually working.
///
/// A relation rather than two more text columns on a model that already carries
/// twenty-four — ordering and per-item alt text both need a row of their own.
model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  /// Cascade so deleting a project cannot strand rows pointing at files that
  /// the delete handler then has no way to find and unlink.
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// "image" or "video". Free text rather than an enum, matching how `type` and
  /// `status` are already handled on Project.
  kind      String
  /// Site-relative and server-generated, e.g. /media/martify-a1b2c3.webp.
  /// Never a value the browser supplied — see lib/media.ts.
  url       String
  /// Required for images. An empty alt has to be a decision, not a default.
  alt       String  @default("")
  /// Video only: the frame shown before playback, and the whole of what a
  /// reduced-motion visitor sees.
  poster    String?
  /// Intrinsic dimensions, captured at upload so the space is reserved before
  /// the file loads and the page does not jump.
  width     Int?
  height    Int?
  order     Int     @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, order])
}

/// Employment history.
///
/// Deliberately NOT seeded. An employment record is a factual claim only the
/// owner can make, so this table ships empty and every consumer hides itself
/// while it is — the same contract as Stat.
model Experience {
  id         String   @id @default(cuid())
  company    String
  role       String
  /// "YYYY-MM". A string, not a DateTime: a CV states month precision, and a
  /// DateTime would fabricate a day and a time that then round-trip through
  /// the viewer's timezone — 2023-06-01T00:00:00Z renders as May 2023 west of
  /// UTC. <input type="month"> produces exactly this format, and zero-padded
  /// YYYY-MM sorts chronologically as a plain string.
  startDate  String
  /// Null means current.
  endDate    String?
  location   String?
  /// Prose, short.
  summary    String?
  /// One per line.
  highlights String?
  url        String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Stops the admin creating an accidental duplicate, and would let a future
  // seed upsert idempotently — though the seed will not touch this table.
  @@unique([company, role, startDate])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String // "Frontend", "Backend", "Tools", etc.
  icon      String? // Icon name or URL
  level     Int      @default(50) // 0-100
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same skill name can appear under different categories, so identity is
  // the pair. Lets the seed upsert instead of duplicating on every run.
  @@unique([name, category])
}

model Service {
  id           String   @id @default(cuid())
  // Unique so the seed can upsert on it and stay idempotent.
  title        String   @unique
  description  String
  icon         String?
  /// "service" renders under Engagements; "process" renders in the Process
  /// section. One model with two presentations rather than a second model:
  /// the three seeded rows literally are the stages of a project, so a
  /// separate ProcessStep table would duplicate them and let the two drift.
  /// Defaults to "service", which preserves the current rendering exactly.
  kind         String   @default("service")
  /// Prose, short. Who this is for.
  audience     String?
  /// One per line. What the client actually receives.
  deliverables String?
  /// Free text — "Fixed scope", "Retainer", "Advisory".
  engagement   String?
  /// Free text — "2–6 weeks".
  duration     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind, order])
}

/// A contact-form submission.
///
/// Persisted before any email is attempted, so a delivery failure cannot lose
/// a message — the route returns success on the strength of this row existing,
/// not on the notification going out.
model Inquiry {
  id          String  @id @default(cuid())
  name        String
  email       String
  company     String?
  /// "hire" | "collaborate" | "question" | "other"
  reason      String?
  projectType String?
  budget      String?
  timeline    String?
  message     String

  /// "new" | "read" | "replied" | "archived"
  status    String    @default("new")
  readAt    DateTime?
  repliedAt DateTime?
  /// Owner's private note. Never rendered publicly.
  notes     String?

  // ── Abuse triage, privacy-minimising by construction ─────────────────
  /// HMAC-SHA256(ip, INQUIRY_IP_SALT), first 16 hex chars. Enough to group
  /// repeat submitters and drive the rate limiter; not reversible to an
  /// address without the salt. The raw IP is never written. If the salt env
  /// var is unset, a random one is generated per process, so hashes then only
  /// correlate within a single process lifetime rather than across restarts.
  ipHash    String?
  /// Truncated to 255 chars. Distinguishes a browser from a curl loop.
  userAgent String?

  createdAt DateTime @default(now())

  // Serves the inbox's default query: unread first, newest first.
  @@index([status, createdAt])
  // Serves the rate-limit count.
  @@index([ipHash, createdAt])
}

/// Headline metrics for the stats strip ("5+ Years of Experience").
/// Deliberately not seeded — these are claims about the owner that only the
/// owner can make truthfully. The strip hides itself while the table is empty.
model Stat {
  id        String   @id @default(cuid())
  label     String   @unique
  value     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model About {
  id        String   @id @default(cuid())
  name      String
  title     String
  bio       String
  email     String?
  phone     String?
  /// Number behind the floating WhatsApp button. Stored as typed; the button
  /// strips everything but digits, since wa.me rejects '+' and spaces.
  whatsapp  String?
  location  String?
  avatar    String?
  resume    String? // URL to resume
  github    String?
  linkedin  String?
  twitter   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hero {
  id          String   @id @default(cuid())
  headline    String
  subheadline String?
  /// The positioning line under the headline: what gets built, and for whom.
  /// Distinct from About.bio, which is the longer personal introduction.
  valueProp   String?
  ctaText     String   @default("View My Work")
  ctaUrl      String   @default("#portfolio")
  background  String? // Background image URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Application configuration editable from /admin/dashboard/settings.
///
/// Exists so changing a Resend key or adding a GitHub token does not mean
/// editing .env on the host and restarting the container. A row here takes
/// precedence over the matching environment variable, which stays as the
/// bootstrap and fallback — see lib/settings.ts for the resolution order.
///
/// Not everything can live here. DATABASE_URL is needed to read this table,
/// NEXTAUTH_SECRET validates the session that guards the page that edits it,
/// and NEXT_PUBLIC_SITE_URL is inlined at build time. Those stay in .env by
/// necessity, not by preference.
model Setting {
  /// The environment-variable name it shadows, e.g. "RESEND_API_KEY".
  key       String   @id
  /// Ciphertext when `encrypted`, plain UTF-8 otherwise. Never returned to the
  /// browser for an encrypted row — the settings API sends only a masked hint.
  value     String
  /// Whether `value` is AES-256-GCM ciphertext. Stored rather than inferred
  /// from the key, so a row written before a key was reclassified still
  /// decrypts correctly instead of being handed back as garbage.
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
